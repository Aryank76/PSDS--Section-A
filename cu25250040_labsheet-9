#include <iostream>
using namespace std;

long long solve(int N, long long A[]) {
    long long sum = 0;
    long long positive = 0;
    long long negative = 0;

    for (int i = 0; i < N; i++) {
        sum += A[i];

        if (A[i] > 0)
            positive += A[i];
        else if (A[i] < 0)
            negative += A[i];
    }

    if (sum > 0)
        return -1;

    if (2 * positive > -negative)
        return -1;

    return -sum;
}

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        long long A[N];

        for (int i = 0; i < N; i++) {
            cin >> A[i];
        }

        cout << solve(N, A) << endl;
    }

    return 0;
}

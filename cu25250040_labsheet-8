#include <iostream>
#include <vector>
using namespace std;

int main() {
    int N, K;
    cin >> N >> K;

    vector<int> arr(N);

    for (int i = 0; i < N; i++) {
        cin >> arr[i];
    }

    // Sum of first K elements
    int windowSum = 0;
    for (int i = 0; i < K; i++) {
        windowSum += arr[i];
    }

    int maxSum = windowSum;

    // Slide the window
    for (int i = K; i < N; i++) {
        windowSum += arr[i];       // Add new element
        windowSum -= arr[i - K];   // Remove old element

        maxSum = max(maxSum, windowSum);
    }

    cout << maxSum << endl;

    return 0;


#include <iostream>
#include <string>
using namespace std;

int main() {
    string S;
    cin >> S;

    int freq[26] = {0};

    int left = 0;
    int maxLength = 0;

    for (int right = 0; right < S.length(); right++) {

        freq[S[right] - 'a']++;

        // If duplicate exists, move left
        while (freq[S[right] - 'a'] > 1) {
            freq[S[left] - 'a']--;
            left++;
        }

        maxLength = max(maxLength, right - left + 1);
    }

    cout << maxLength << endl;

    return 0;
}




#include <iostream>
#include <vector>
#include <queue>
#include <climits>
using namespace std;

typedef pair<int, int> pii;

int main() {
    int N, M, K;
    cin >> N >> M >> K;

    // Adjacency list
    vector<vector<pii>> graph(N + 1);

    for (int i = 0; i < M; i++) {
        int u, v, weight;
        cin >> u >> v >> weight;

        graph[u].push_back({v, weight});
        graph[v].push_back({u, weight});
    }

    // dist[node][number of edges used]
    vector<vector<long long>> dist(
        N + 1,
        vector<long long>(K + 1, LLONG_MAX)
    );

    // {cost, node, edges_used}
    using State = tuple<long long, int, int>;

    priority_queue<State, vector<State>, greater<State>> pq;

    // Start from node 1 with 0 edges
    dist[1][0] = 0;
    pq.push({0, 1, 0});

    while (!pq.empty()) {

        auto [cost, u, edges] = pq.top();
        pq.pop();

        // Ignore outdated state
        if (cost != dist[u][edges])
            continue;

        // Cannot use more than K edges
        if (edges == K)
            continue;

        // Explore neighbours
        for (auto [v, weight] : graph[u]) {

            long long newCost = cost + weight;
            int newEdges = edges + 1;

            if (newCost < dist[v][newEdges]) {

                dist[v][newEdges] = newCost;

                pq.push({
                    newCost,
                    v,
                    newEdges
                });
            }
        }
    }

    // Find minimum cost using at most K edges
    long long answer = LLONG_MAX;

    for (int edges = 0; edges <= K; edges++) {
        answer = min(answer, dist[N][edges]);
    }

    if (answer == LLONG_MAX)
        cout << -1 << endl;
    else
        cout << answer << endl;

    return 0;
}
